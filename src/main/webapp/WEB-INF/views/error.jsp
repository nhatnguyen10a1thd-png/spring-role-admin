<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Không thể mở trang · AdminSpace</title><link rel="stylesheet" href="<c:url value='/static/vendor/bootstrap/bootstrap.min.css'/>"><link rel="stylesheet" href="<c:url value='/static/css/admin.css'/>"></head><body class="standalone-body"><main class="error-page"><div class="error-card"><div class="error-code" aria-hidden="true"><c:out value="${empty status ? '!' : status}"/></div><h1>${status == 404 ? 'Không tìm thấy nội dung' : 'Không thể thực hiện yêu cầu'}</h1><p><c:choose><c:when test="${not empty errorMessage}"><c:out value="${errorMessage}"/></c:when><c:when test="${status == 404}">Trang hoặc bản ghi bạn tìm kiếm không còn tồn tại. Vui lòng kiểm tra lại đường dẫn.</c:when><c:otherwise>Đã có lỗi trong khi xử lý yêu cầu. Vui lòng thử lại hoặc liên hệ quản trị viên nếu lỗi tiếp tục xảy ra.</c:otherwise></c:choose></p><div class="error-actions"><a class="btn btn-primary" href="<c:url value='/'/>">Về trang chủ</a><a class="btn btn-outline-secondary" href="<c:url value='/admin'/>">Trang quản trị</a></div></div></main></body></html>
