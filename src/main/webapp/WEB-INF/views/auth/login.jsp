<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Đăng nhập · AdminSpace</title><link rel="stylesheet" href="<c:url value='/static/vendor/bootstrap/bootstrap.min.css'/>"><link rel="stylesheet" href="<c:url value='/static/css/admin.css'/>"></head>
<body class="standalone-body"><main class="login-shell"><section class="login-story" aria-label="AdminSpace"><a class="brand" href="<c:url value='/'/>"><span class="brand-mark" aria-hidden="true">a<span>■</span></span><span>Admin<span class="brand-light">Space</span></span></a><div class="login-story-main"><h1>Hệ thống<br>quản trị</h1><p>Đăng nhập để quản lý danh mục và người dùng.</p></div></section><section class="login-main" aria-labelledby="login-title"><div class="login-card"><h2 id="login-title">Đăng nhập</h2>
<c:if test="${param.error != null}"><div class="alert alert-danger" role="alert">Tên đăng nhập hoặc mật khẩu không đúng, hoặc tài khoản đã bị khóa.</div></c:if><c:if test="${param.logout != null}"><div class="alert alert-success" role="status">Bạn đã đăng xuất thành công.</div></c:if><c:if test="${param.expired != null}"><div class="alert alert-info" role="status">Phiên đăng nhập đã kết thúc. Vui lòng đăng nhập lại.</div></c:if>
<form method="post" action="<c:url value='/login'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="mb-4"><label class="form-label" for="username">Tên đăng nhập</label><input class="form-control" id="username" name="username" type="text" autocomplete="username" placeholder="Nhập tên đăng nhập" required autofocus maxlength="50"></div><div class="mb-4"><label class="form-label" for="password">Mật khẩu</label><div class="password-wrap"><input class="form-control" id="password" name="password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required><button type="button" class="password-toggle" data-toggle-password="password" aria-label="Hiện mật khẩu" aria-pressed="false">Hiện</button></div></div><button type="submit" class="btn btn-primary w-100">Đăng nhập</button></form></div></section></main><script src="<c:url value='/static/js/admin.js'/>"></script></body></html>
