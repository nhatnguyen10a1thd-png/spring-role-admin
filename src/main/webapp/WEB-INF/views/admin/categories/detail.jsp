<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Chi tiết danh mục</title></head><body>
<a class="back-link" href="<c:url value='/admin/categories'/>"><span aria-hidden="true">←</span> Trở về danh sách danh mục</a>
<div class="page-heading"><div><h1>Chi tiết danh mục</h1></div><a class="btn btn-primary" href="<c:url value='/admin/categories/${category.id}/edit'/>">Chỉnh sửa danh mục</a></div>
<%@ include file="../../fragments/flash.jsp" %>
<div class="form-layout"><section class="panel"><div class="detail-body"><div class="detail-hero"><span class="detail-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10H3Z"/></svg></span><div><h2><c:out value="${category.name}"/></h2><span class="status-badge ${category.active ? '' : 'status-inactive'}">${category.active ? 'Hoạt động' : 'Tạm ẩn'}</span></div></div><dl class="detail-rows"><div class="detail-row"><dt>Mã danh mục</dt><dd><span class="muted-id">#${category.id}</span></dd></div><div class="detail-row"><dt>Tên danh mục</dt><dd><c:out value="${category.name}"/></dd></div><div class="detail-row"><dt>Mô tả</dt><dd class="pre-wrap"><c:out value="${empty category.description ? 'Chưa có mô tả.' : category.description}"/></dd></div><div class="detail-row"><dt>Trạng thái</dt><dd>${category.active ? 'Đang hoạt động' : 'Đang tạm ẩn'}</dd></div></dl></div><div class="form-actions"><a href="<c:url value='/admin/categories'/>" class="btn btn-outline-secondary">Trở về danh sách</a><form method="post" action="<c:url value='/admin/categories/${category.id}/delete'/>" data-confirm-delete><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button type="submit" class="btn btn-outline-danger">Xóa danh mục</button></form></div></section></div>
</body></html>
